# Copy to .env for local development (`npm run dev` loads it). Never commit .env.

# Required: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# In production, mount the key as a secret file instead and point to it (this wins if both are set):
# GEMINI_API_KEY_FILE=/mnt/secrets/gemini-api-key

# Optional (defaults shown)
# Models tried in order: the next one is used if a model is overloaded, too slow or returns an unusable plan.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
PORT=8080
# Plan requests allowed per client, and across all clients (a cap on AI spending), per minute.
RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=120
# Proxies in front of the server that append to X-Forwarded-For: 0 locally, 1 on Cloud Run,
# 2 behind an external Application Load Balancer. Rate limits then use the real client IP.
TRUSTED_PROXIES=0
